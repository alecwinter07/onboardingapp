# Must match the secret used in n8n workflow 04 (Generate-Questionnaire-Link)
# and the Crypto node's Hmac Secret value
QUESTIONNAIRE_JWT_SECRET=lm-jwt-secret-2025

# n8n webhook that saves section answers to Airtable + advances stage
# (new workflow to build: "Questionnaire-Section-Submit")
N8N_QUESTIONNAIRE_WEBHOOK_URL=https://n8n.level.us/webhook/questionnaire-section-submit

# n8n webhook that proxies file uploads to Google Drive
# (new workflow to build: "Questionnaire-File-Upload")
N8N_UPLOAD_WEBHOOK_URL=https://n8n.level.us/webhook/questionnaire-file-upload
